# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — الأسرار ما بتنرفع. .env.example مستثنى من الاستثناء لأنه
# مرجع المفاتيح المطلوبة (بلا قيم).
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# prisma sqlite dev database (rebuild via: npx prisma migrate dev && npx prisma db seed)
/prisma/dev.db
/prisma/dev.db-journal

# إعدادات أدوات المحرر/الوكلاء (نسخ توثيق محلية، مالها علاقة بالمشروع)
/.claude/
/.agents/
/.windsurf/
/.vscode/

# ملفات التصميم (Claude Design) — مرجع محلي، مالها علاقة بالكود
"/RxChef ui-ux/"
