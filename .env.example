# انسخ هالملف لـ.env وعبّي القيم. ملف .env مستثنى من git — ما بينرفع أبداً.
# نفس هالمفاتيح لازم تنضاف بإعدادات الاستضافة (Vercel → Settings → Environment Variables).

# ── قاعدة البيانات (PostgreSQL) ──────────────────────────────────────
# بيقبل الشكلين، والكود بيختار المحرّك المناسب لحاله:
#   prisma+postgres://accelerate.prisma-data.net/?api_key=...   (HTTPS، منفذ 443)
#   postgres://user:pass@host:5432/postgres?sslmode=require     (TCP، منفذ 5432)
# ملاحظة: إذا شبكتك حاجبة المنفذ 5432، استخدم رابط الـHTTPS.
DATABASE_URL=""

# ── خدمة التحليل (FastAPI) ───────────────────────────────────────────
# محلياً: http://localhost:8000
# بالإنتاج: رابط الخدمة على الاستضافة، مثلاً https://rxchef-api.onrender.com
FASTAPI_URL="http://localhost:8000"

# ── لوحة الإدارة ─────────────────────────────────────────────────────
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# مفتاح توقيع كوكي الجلسة. ولّد واحد جديد للإنتاج:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""
